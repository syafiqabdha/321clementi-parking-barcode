# Frontend / Mobile Web Portal Configuration
# Public webhook endpoint for receipt verification and voucher issuance
PUBLIC_REDEMPTION_WEBHOOK_URL=https://n8n.pancatz.com/webhook/clementi-redemption

# Database Configuration
# On Vercel this must be a network-reachable endpoint (managed Postgres or a
# pooler such as Supabase :6543 / Neon pooled / PgBouncer). localhost is not
# reachable from a Vercel function.
DATABASE_URL=postgresql://user:***@localhost:5432/clementi_redemption
TEST_DATABASE_URL=postgresql://postgres:***@localhost:55432/test_clementi

# Database driver tuning (optional — defaults suit Vercel serverless)
# PG_POOL_MAX=1              connections per function instance (default 1 on Vercel, 10 elsewhere)
# PG_IDLE_TIMEOUT=20         seconds before an idle connection is closed
# PG_CONNECT_TIMEOUT=10      seconds to wait for a new connection
# PG_PREPARE=true            only for direct/session-mode endpoints; must stay false behind a
#                            transaction-mode pooler (PgBouncer, Supabase :6543, Neon pooled)
# PG_SSL=true                force TLS when the URL has no sslmode= parameter
# PG_SSL_NO_VERIFY=true      skip certificate verification (self-signed certs only)

# PII & Data Protection (HMAC-SHA256 Secret Pepper)
PLATE_HMAC_SECRET=replace_with_64_char_crypto_random_secret

# Service Endpoints (Enforce HTTPS)
N8N_WEBHOOK_URL=https://n8n.pancatz.com/webhook/clementi-redemption
NOCODB_URL=https://nocodb.pancatz.com

# AI Receipt Verification (PAN-84 / TSK-06)
# Obtain from https://aistudio.google.com/app/apikey
# Required in production: verifyReceipt() fails closed when unset.
GEMINI_API_KEY=

# Optional: n8n webhook fallback for AI receipt verification
# If set, overrides the direct Gemini call
N8N_RECEIPT_VERIFIER_URL=

# Cloudflare Turnstile Bot Protection (PAN-84 / TSK-07)
# Obtain from https://dash.cloudflare.com — Turnstile → Add Site
# NOTE: CLIENT- AND SERVER-SIDE WIRING IS INCOMPLETE.
#  * No Turnstile widget is rendered in the browser (nothing in src/ reads
#    PUBLIC_TURNSTILE_SITE_KEY), so no cf-turnstile-response field is posted.
#  * verifyTurnstileToken() therefore fails closed in production and rejects
#    every redemption with BOT_CHALLENGE_FAILED.
# Leave CLOUDFLARE_TURNSTILE_SECRET_KEY unset in production only until the
# widget is wired — the gate is skipped entirely when the secret is absent.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Administrator Management (PAN-87)
# Admin API and NocoDB script deployment tokens
ADMIN_API_KEY=
XC_TOKEN=

# Node Environment
NODE_ENV=development
