# =============================================================================
# 321 Clementi Parking Barcode — environment template
#
# Local development:
#   cp .env.example .env && $EDITOR .env
#   # keep DATABASE_URL pointing at a local PostgreSQL 16, then:
#   bun run db:migrate && bun run dev
#
# Coolify / docker compose deployment:
#   cp .env.example .env && $EDITOR .env      # fill every REQUIRED value
#   docker compose up -d db
#   docker compose run --rm web bun run db:migrate
#   docker compose up -d web
#   See docs/operations/COOLIFY_DEPLOYMENT.md
# =============================================================================

# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------
# development | production. In production the receipt verifier and the Turnstile
# gate both FAIL CLOSED when their keys are missing.
NODE_ENV=development

# Frontend / Mobile Web Portal Configuration
# Public webhook endpoint for receipt verification and voucher issuance
PUBLIC_REDEMPTION_WEBHOOK_URL=https://n8n.pancatz.com/webhook/clementi-redemption

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Used by `bun run dev`, `bun run db:migrate` and the test suite on the host.
# REQUIRED. Inside docker compose the web container is given
# postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB
# automatically — this value is NOT passed through to the container.
DATABASE_URL=postgresql://user:password@localhost:5432/clementi_redemption
TEST_DATABASE_URL=postgresql://postgres:password@localhost:55432/test_clementi

# PII & Data Protection (HMAC-SHA256 Secret Pepper) — REQUIRED
# 64 hex characters. Generate with: openssl rand -hex 32
PLATE_HMAC_SECRET=replace_with_64_char_crypto_random_secret

# -----------------------------------------------------------------------------
# Service Endpoints (Enforce HTTPS)
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=https://n8n.pancatz.com/webhook/clementi-redemption
NOCODB_URL=https://nocodb.pancatz.com

# -----------------------------------------------------------------------------
# AI Receipt Verification (PAN-84 / TSK-06)
# -----------------------------------------------------------------------------
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: n8n webhook fallback for AI receipt verification
# If set, overrides the direct Gemini call
N8N_RECEIPT_VERIFIER_URL=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile Bot Protection (PAN-84 / TSK-07)
# Obtain from https://dash.cloudflare.com — Turnstile → Add Site
# CLOUDFLARE_TURNSTILE_SECRET_KEY is REQUIRED in production (fails closed).
# -----------------------------------------------------------------------------
CLOUDFLARE_TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# Administrator Management (PAN-87)
# REQUIRED. Bearer token / X-Admin-Key for /api/v1/admin/shops.
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
ADMIN_API_KEY=
# NocoDB admin API token for scripts/deploy-nocodb-config.sh verification.
# Obtain from NocoDB → Team & Auth → API Tokens.
XC_TOKEN=

# =============================================================================
# Deployment / Coolify orchestration (docker-compose.yml)
# These are consumed by `docker compose` itself, not by the Astro app.
# =============================================================================

# --- PostgreSQL 16 container -------------------------------------------------
POSTGRES_USER=clementi
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=clementi_redemption

# --- Published ports ---------------------------------------------------------
# Nothing in docker-compose.yml publishes a host port: ingress is the Coolify
# proxy's job (Cloudflare Tunnel -> Traefik -> web:4321). Publishing one would
# bypass the proxy and the tunnel and strip `cf-connecting-ip`, which the
# redemption rate limiter trusts. CI enforces this.
#
# The variables below are read ONLY by docker-compose.verify.yml, the
# never-deployed verification overlay. They are not deployment settings.
#   Local verification: WEB_HOST_PORT=4321
#   (VERIFY_DB_PORT defaults to 15432 and is loopback-bound too.)
WEB_HOST_PORT=4321

# --- Image tag ---------------------------------------------------------------
IMAGE_TAG=local

# --- Astro CSRF origin allowlist (BUILD-TIME, baked into the image) ----------
# Comma separated hostnames, no scheme. Rebuild the image after changing this.
ALLOWED_SITE_DOMAINS=321clementi.pancatz.com

# --- Bun SQL pool tuning -----------------------------------------------------
# Leave unset to use the default of 10.
PG_POOL_MAX=
PG_CONNECT_TIMEOUT=10

# --- NocoDB container (docker compose --profile nocodb) ----------------------
# Signs NocoDB session tokens. Generate with: openssl rand -hex 32
NC_AUTH_JWT_SECRET=

# NocoDB's own metadata database. Keep it separate from POSTGRES_DB: pointed at
# the application database, NocoDB materialises ~140 `nc_*` tables into `public`
# alongside shops / voucher_pool / redemption_logs.
NC_META_DB=nocodb_meta

# Password for the least-privilege `mall_operations` role that NocoDB uses as its
# data source (scripts/nocodb-db-roles.sql). Generate with: openssl rand -hex 24
# Copy this value into Coolify as MALL_OPS_DB_PASSWORD.
MALL_OPS_DB_PASSWORD=

# Optional: pre-provision the NocoDB super admin so the first visit skips the
# signup prompt. Setting NC_ADMIN_EMAIL without a password aborts NocoDB boot.
NC_ADMIN_EMAIL=
NC_ADMIN_PASSWORD=

