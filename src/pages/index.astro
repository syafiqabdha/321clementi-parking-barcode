---
import BaseLayout from '../layouts/BaseLayout.astro';
import RedemptionBanner from '../components/RedemptionBanner.astro';
import RedemptionCard from '../components/RedemptionCard.astro';
import StepGuide from '../components/StepGuide.astro';
---

<BaseLayout
  title="321 Clementi | Smart Parking Redemption"
  description="Autonomous receipt-to-barcode parking redemption for 321 Clementi. 2 hours free parking (12:00 PM - 3:00 PM weekdays)."
>
  <!-- Operating Hours & Fast-Fail Window Banner -->
  <RedemptionBanner />

  <!-- Primary Mobile-First Card Container (Basement High-Contrast Optimized) -->
  <RedemptionCard />

  <!-- 3-Step Shopper Guidance -->
  <StepGuide />
</BaseLayout>
