---
import BaseLayout from '../layouts/BaseLayout.astro';
import RedemptionBanner from '../components/RedemptionBanner.astro';
import RedemptionCard from '../components/RedemptionCard.astro';
import StepGuide from '../components/StepGuide.astro';
import CarparkRates from '../components/CarparkRates.astro';

// Every element on this page is static markup — all behaviour (form submit,
// barcode render, history, unclaim) is client-side fetch against /api/v1/**.
// Prerender it so the shopper landing page is served as a static asset instead
// of an SSR render, while the API routes stay request-time handlers.
export const prerender = true;
---

<BaseLayout
  title="321 Clementi | Free 2 hours Parking Redemption"
  description="Autonomous receipt-to-barcode parking redemption for 321 Clementi. 2 hours free parking (12:00 PM – 3:00 PM weekdays, min. spend $30)."
>
  <!-- Operating Hours & Live Promotion Window Banner -->
  <RedemptionBanner />

  <!-- Primary Mobile-First Card Container (Active Intake, Closed State & Barcode Pass) -->
  <RedemptionCard />

  <!-- 3-Step Shopper Guidance -->
  <StepGuide />

  <!-- Standard Carpark Rates Bento Grid -->
  <CarparkRates />
</BaseLayout>
