---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '321 Clementi | Smart Parking Barcode Redemption',
  description = 'Redeem 2 hours complimentary parking at 321 Clementi. Scan your lunch receipt (12:00 PM – 3:00 PM weekdays) for an instant carpark barcode.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ED1651" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/brand/favicon.png" />
    
    <!-- Google Fonts Preconnect & Display Swap for ultra-fast initial render -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-clementi-subtle text-clementi-charcoal selection:bg-pink-100 selection:text-clementi-crimson">
    <Header />

    <main id="main-content" class="flex-1 w-full max-w-md mx-auto px-4 py-5 flex flex-col items-center">
      <slot />
    </main>

    <Footer />
  </body>
</html>
