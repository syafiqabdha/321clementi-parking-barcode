---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '321 Clementi | Free 2 hours Parking Redemption',
  description = 'Autonomous receipt-to-barcode parking redemption for 321 Clementi. 2 hours free parking (12:00 PM – 3:00 PM weekdays, min. spend $30).',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ED1651" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/brand/favicon.png" />

    <!-- Preload Century Gothic Brand Typography -->
    <link
      rel="preload"
      href="/fonts/centurygothic_bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/centurygothic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    
    <!-- Google Fonts Preconnect & Inter Body Copy -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Material Symbols Outlined Icons -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-clementi-subtle text-clementi-charcoal selection:bg-pink-100 selection:text-clementi-crimson">
    <!-- Top Brand Spectrum Ribbon (6-stripe mall spectrum: Green -> Cyan -> Lavender -> Pink -> Crimson -> Orange) -->
    <div class="w-full flex h-1.5 z-50 sticky top-0" aria-hidden="true">
      <div class="flex-1 bg-clementi-green" title="Fresh Leaf Green"></div>
      <div class="flex-1 bg-clementi-cyan" title="Coastal Cyan"></div>
      <div class="flex-1 bg-clementi-lavender" title="Wisteria Lavender"></div>
      <div class="flex-1 bg-clementi-pink" title="Blossom Pink"></div>
      <div class="flex-1 bg-clementi-crimson" title="Clementi Crimson"></div>
      <div class="flex-1 bg-clementi-orange" title="Tangerine Orange"></div>
    </div>

    <!-- Sticky Top App Bar -->
    <Header />

    <!-- Main Content Container -->
    <main id="main-content" class="flex-1 w-full max-w-md mx-auto px-4 py-4 flex flex-col items-center pb-24">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Bottom Navigation Bar -->
    <BottomNav />
  </body>
</html>
