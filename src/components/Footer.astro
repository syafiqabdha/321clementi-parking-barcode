---
// Footer component with official 321 Clementi mall premises address and expandable terms
---

<footer
  id="terms-section"
  class="w-full mt-auto border-t border-clementi-border bg-clementi-white py-6 text-center text-xs text-clementi-slate"
  role="contentinfo"
>
  <div class="max-w-md mx-auto px-4 space-y-4">
    <!-- Premises Address -->
    <div class="text-center text-xs text-clementi-slate leading-relaxed">
      <strong class="font-display font-bold text-clementi-charcoal text-xs block">321 Clementi</strong>
      <p class="text-[11px] text-clementi-slate">321 Clementi Ave 3, Singapore 129905</p>
      <p class="text-[10px] text-clementi-slate/80">Carpark Entry via Clementi Ave 3</p>
    </div>

    <!-- Expandable Terms & Conditions Card (9 clauses) -->
    <div class="bg-clementi-subtle rounded-xl p-4 text-left border border-clementi-border space-y-2.5">
      <button
        type="button"
        id="toggle-terms-btn"
        class="w-full flex items-center justify-between cursor-pointer focus:outline-none"
        aria-expanded="false"
        aria-controls="terms-list"
      >
        <span class="font-display text-xs font-bold text-clementi-charcoal uppercase tracking-wider flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm text-clementi-crimson">gavel</span>
          Terms & Conditions
        </span>
        <span class="material-symbols-outlined text-clementi-slate text-base transition-transform" id="terms-arrow">
          expand_more
        </span>
      </button>

      <ol id="terms-list" class="hidden font-body text-[11px] text-clementi-slate space-y-1.5 list-decimal list-inside leading-relaxed pt-1 border-t border-clementi-border/60">
        <li>Valid exclusively for vehicle entries Mondays to Fridays between 12:00 PM and 3:00 PM, excluding Singapore Public Holidays.</li>
        <li>Qualifying spend requires a minimum of $30.00 SGD consolidated from a maximum of two (2) same-day receipts.</li>
        <li>Only official point-of-sale machine-printed receipts with clear merchant GST registration numbers are eligible.</li>
        <li>Receipts from atrium pop-ups, temporary pushcarts, bill payment kiosks, convenience top-ups, money changers, Clementi Family & Aesthetic Clinic, and GynaeMD Women's Clinic are strictly excluded.</li>
        <li>Redemption is strictly limited to one (1) 2-hour complimentary parking voucher per vehicle / patron per calendar day.</li>
        <li>Vouchers are valid only on the date of issue and must be scanned at the gantry exit reader prior to vehicle egress.</li>
        <li>Prevailing carpark rates will automatically apply for parking durations extending beyond the 2 complimentary hours.</li>
        <li>Vouchers are strictly non-transferable, non-refundable, and cannot be exchanged for cash, credits, or gift cards.</li>
        <li>The Management of 321 Clementi reserves the right to amend terms, alter promotional quotas, or reject invalid receipts without prior notice.</li>
      </ol>
    </div>

    <!-- Links from Shared Components Blueprint -->
    <div class="flex flex-wrap justify-center items-center gap-3 text-[11px] text-clementi-slate pt-1">
      <a class="hover:text-clementi-crimson transition-colors" href="#terms-section">Terms & Conditions</a>
      <span>•</span>
      <a class="hover:text-clementi-crimson transition-colors" href="#carpark-rates-section">Carpark Policy</a>
      <span>•</span>
      <a class="hover:text-clementi-crimson transition-colors" href="#terms-section">Privacy Promise</a>
    </div>

    <!-- Copyright -->
    <p class="text-[11px] text-slate-400 pt-1">
      &copy; {new Date().getFullYear()} Engwah Private Limited • 321 Clementi. All Rights Reserved.
    </p>
  </div>
</footer>

<script>
  const toggleBtn = document.getElementById('toggle-terms-btn');
  const termsList = document.getElementById('terms-list');
  const termsArrow = document.getElementById('terms-arrow');

  toggleBtn?.addEventListener('click', () => {
    const isHidden = termsList?.classList.contains('hidden');
    if (isHidden) {
      termsList?.classList.remove('hidden');
      if (termsArrow) termsArrow.textContent = 'expand_less';
      toggleBtn.setAttribute('aria-expanded', 'true');
    } else {
      termsList?.classList.add('hidden');
      if (termsArrow) termsArrow.textContent = 'expand_more';
      toggleBtn.setAttribute('aria-expanded', 'false');
    }
  });
</script>
