---
// Footer component with mall info and terms
---

<footer class="w-full mt-auto border-t border-clementi-border bg-clementi-white py-6 text-center text-xs text-clementi-slate" role="contentinfo">
  <div class="max-w-md mx-auto px-4 space-y-3">
    <!-- Brand wordmark echo -->
    <div class="font-display font-bold text-xs uppercase tracking-wordmark text-clementi-crimson">
      321 C L E M E N T I
    </div>

    <!-- Address & Location -->
    <p class="leading-relaxed">
      321 Clementi Ave 3, Singapore 129905<br />
      Carpark Entry via Clementi Ave 3
    </p>

    <!-- Key Terms & Conditions Summary -->
    <div class="bg-clementi-subtle rounded-md p-3 text-[11px] text-clementi-slate/90 leading-relaxed border border-clementi-border/60 text-left">
      <strong class="text-clementi-charcoal block mb-1">Promotion Terms & Conditions:</strong>
      <ul class="list-disc pl-4 space-y-0.5">
        <li>Valid for redemptions made between 12:00 PM – 3:00 PM on Mondays to Fridays (excluding Public Holidays).</li>
        <li>Single same-day receipt with minimum spending of $30.00 nett.</li>
        <li>Limited to one (1) redemption per vehicle registration number per calendar day.</li>
        <li>Code 128 barcode is valid for 15 minutes upon issuance for single carpark exit scan.</li>
      </ul>
    </div>

    <!-- Copyright -->
    <p class="text-[10px] text-clementi-slate/60 pt-2">
      &copy; {new Date().getFullYear()} 321 Clementi. All rights reserved. Powered by Autonomous Redemption Engine.
    </p>
  </div>
</footer>
