---
// 3-step visual redemption flow refined from Stitch UI export
const steps = [
  {
    num: '1',
    title: 'Spend Min. $30 Same-Day',
    desc: 'Combine up to 2 same-day receipts from any participating F&B or retail store within 321 Clementi (excl. clinics & pushcarts).',
    badgeBg: 'bg-clementi-orange',
    badgeText: 'text-white',
  },
  {
    num: '2',
    title: 'Upload Receipt & Plate',
    desc: 'Snap receipt photo and enter vehicle IU plate number for instantaneous automated OCR validation. No queueing needed!',
    badgeBg: 'bg-clementi-cyan',
    badgeText: 'text-white',
  },
  {
    num: '3',
    title: 'Scan Code at Exit Gantry',
    desc: 'Remove CashCard from IU and present your optical Code 128 barcode directly at the basement carpark exit scanner.',
    badgeBg: 'bg-clementi-crimson',
    badgeText: 'text-white',
  },
];
---

<section
  class="w-full bg-clementi-white rounded-2xl border border-clementi-border p-4 sm:p-5 shadow-sm space-y-3.5 mb-5"
  aria-labelledby="steps-heading"
>
  <div class="flex items-center gap-2">
    <span class="w-2 h-2 rounded-full bg-clementi-crimson"></span>
    <h3 id="steps-heading" class="font-display text-xs font-bold uppercase tracking-wider text-clementi-slate">
      How Free 2-Hour Parking Redemption Works
    </h3>
  </div>

  <div class="space-y-3">
    {steps.map((step) => (
      <div class="bg-clementi-subtle border border-clementi-border rounded-xl p-3 sm:p-3.5 flex items-start gap-3.5 transition-colors">
        <div class={`w-7 h-7 rounded-full ${step.badgeBg} ${step.badgeText} font-display font-bold text-xs sm:text-sm flex items-center justify-center shrink-0 shadow-xs mt-0.5`}>
          {step.num}
        </div>
        <div class="flex-1 min-w-0">
          <h4 class="font-display text-sm font-bold text-clementi-charcoal">
            {step.title}
          </h4>
          <p class="font-body text-xs text-clementi-slate mt-0.5 leading-relaxed">
            {step.desc}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
