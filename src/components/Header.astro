---
// Minimal TopAppBar Component
// Displays only the 321 Clementi logo on the left.
---

<header
  class="w-full bg-clementi-white border-b border-clementi-border sticky top-1.5 z-40 shadow-xs"
  role="banner"
>
  <div class="w-full max-w-md mx-auto flex items-center px-4 py-2.5">
    <!-- Left: Official 321 Clementi Logo -->
    <a href="/" class="flex items-center shrink-0" aria-label="321 Clementi Home">
      <img
        src="/brand/logo.png"
        alt="321 Clementi"
        class="h-9 w-auto object-contain"
        width="36"
        height="36"
        loading="eager"
      />
    </a>
    <h1 class="sr-only">Free 2 hours Parking Redemption</h1>
  </div>
</header>
