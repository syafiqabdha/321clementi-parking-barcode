---
// Mobile-first card container optimized for basement mall lighting.
// High contrast (WCAG AAA for text), clear touch targets, and resilient visibility.
// Implements client-side HTML5 canvas downsampling, LTA MOD-19 plate validation, and Code 128 barcode rendering.
---

<div
  class="w-full bg-clementi-white rounded-lg border border-clementi-border shadow-card overflow-hidden transition-all mb-6"
  data-testid="redemption-card-container"
>
  <!-- 321 Clementi Brand Ribbon (6-color spectrum top accent) -->
  <div class="h-1.5 w-full flex" aria-hidden="true">
    <div class="h-full flex-1 bg-[#71BF45]" title="Fresh Leaf Green"></div>
    <div class="h-full flex-1 bg-[#38BEDD]" title="Coastal Cyan"></div>
    <div class="h-full flex-1 bg-[#A87FB7]" title="Wisteria Lavender"></div>
    <div class="h-full flex-1 bg-[#EF5A92]" title="Blossom Pink"></div>
    <div class="h-full flex-1 bg-[#ED1651]" title="Clementi Crimson"></div>
    <div class="h-full flex-1 bg-[#F47820]" title="Tangerine Orange"></div>
  </div>

  <!-- SECTION 1: INTAKE & REDEMPTION FORM -->
  <div id="redemption-form-section" class="p-5 sm:p-6 space-y-5">
    <!-- Card Heading -->
    <div class="text-left">
      <div class="inline-flex items-center gap-1.5 text-xs font-bold text-clementi-crimson uppercase tracking-wider font-display mb-1">
        <span>Autonomous Self-Service</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-clementi-charcoal font-display tracking-tight">
        Claim Parking Voucher
      </h2>
      <p class="text-xs sm:text-sm text-clementi-slate mt-1 font-body leading-relaxed">
        Skip the Information Counter queue. Verify your same-day receipt in seconds to receive an instant Code 128 barcode for car park exit.
      </p>
    </div>

    <!-- Error Alert Banner (Hidden by default) -->
    <div
      id="error-banner"
      class="hidden rounded-md bg-red-50 border border-red-200 p-3 text-xs text-red-800 flex items-start gap-2"
      role="alert"
    >
      <svg class="w-4 h-4 text-red-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
      </svg>
      <div id="error-banner-message" class="font-medium">Please correct the highlighted errors.</div>
    </div>

    <!-- Intake Form -->
    <form id="redemption-form" class="space-y-4" onsubmit="return false;">
      <!-- Step 1: Vehicle Plate Number -->
      <div>
        <label for="vehicle-plate" class="block text-xs font-bold uppercase tracking-wider text-clementi-charcoal font-display mb-1.5">
          Vehicle Registration Number <span class="text-clementi-crimson" aria-hidden="true">*</span>
        </label>
        <div class="relative">
          <input
            type="text"
            id="vehicle-plate"
            name="vehiclePlate"
            placeholder="e.g. SBA 1234 A"
            maxlength="10"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            class="w-full px-3.5 py-3 rounded-md border-2 border-clementi-border focus:border-clementi-crimson focus:ring-2 focus:ring-pink-100 text-clementi-charcoal font-display font-bold text-base tracking-widest placeholder:text-gray-400 placeholder:font-normal placeholder:tracking-normal transition-all outline-none uppercase bg-[#F8F9FA]"
            required
            aria-describedby="plate-helper"
          />
          <div id="plate-status-icon" class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center gap-1.5 pointer-events-none">
            <span class="text-xs font-bold text-clementi-slate/70 font-display">SG</span>
          </div>
        </div>
        <div id="plate-feedback" class="text-[11px] text-clementi-slate mt-1.5 flex items-center gap-1 transition-colors">
          <svg class="w-3.5 h-3.5 text-clementi-slate/80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="plate-feedback-text">Validated with LTA MOD-19 checksum (1 pass per vehicle / patron per day).</span>
        </div>
      </div>

      <!-- Step 2: Receipt Upload Preview & Trigger -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-bold uppercase tracking-wider text-clementi-charcoal font-display">
            Mall Receipt Photo <span class="text-clementi-crimson" aria-hidden="true">*</span>
          </label>
          <span class="text-[11px] text-clementi-slate font-medium">Min. $30 spend</span>
        </div>
        
        <!-- Dropzone / Camera Trigger -->
        <div
          id="receipt-dropzone"
          class="relative border-2 border-dashed border-clementi-border hover:border-clementi-crimson rounded-md p-4 bg-[#F8F9FA] text-center transition-colors cursor-pointer group"
          role="button"
          tabindex="0"
          aria-label="Upload or snap mall receipt"
        >
          <input
            type="file"
            id="receipt-file-input"
            accept="image/*"
            capture="environment"
            class="sr-only"
            aria-hidden="true"
          />

          <!-- Default State (Prompt) -->
          <div id="dropzone-prompt" class="flex flex-col items-center justify-center py-2">
            <div class="w-11 h-11 rounded-full bg-pink-50 text-clementi-crimson flex items-center justify-center mb-2 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <span class="text-sm font-bold text-clementi-charcoal font-display">
              Tap to Snap or Upload Receipt
            </span>
            <span class="text-xs text-clementi-slate mt-0.5">
              Single same-day receipt showing date, store name & total ≥ $30.00
            </span>
          </div>

          <!-- Preview State (Shown when photo selected) -->
          <div id="dropzone-preview" class="hidden flex items-center gap-3 py-1">
            <div class="relative w-14 h-14 rounded-md overflow-hidden bg-gray-100 flex-shrink-0 border border-gray-200">
              <img id="preview-thumbnail" src="" alt="Receipt thumbnail" class="w-full h-full object-cover" />
            </div>
            <div class="flex-1 text-left min-w-0">
              <p id="preview-filename" class="text-xs font-bold text-clementi-charcoal truncate font-display">receipt.jpg</p>
              <div class="flex items-center gap-2 mt-1">
                <span id="preview-badge" class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-green-100 text-green-800">
                  Compressed: ~200 KB
                </span>
                <span class="text-[11px] text-clementi-slate">Ready</span>
              </div>
            </div>
            <button
              type="button"
              id="retake-receipt-btn"
              class="text-xs font-bold text-clementi-crimson hover:underline px-2 py-1"
            >
              Retake
            </button>
          </div>
        </div>

        <!-- Store Exclusions Note -->
        <p class="text-[11px] text-amber-800 bg-amber-50/80 border border-amber-200/60 rounded px-2.5 py-1.5 mt-2 leading-tight">
          <strong>Store Exclusions:</strong> Not applicable to Clementi Family & Aesthetic Clinic and GynaeMD Women's Clinic.
        </p>
      </div>

      <!-- Action Button (Clementi Crimson #ED1651) -->
      <div class="pt-1">
        <button
          type="button"
          id="submit-redemption-btn"
          class="w-full py-3.5 px-5 bg-action-primary hover:bg-action-hover active:bg-[#C0103E] text-clementi-white font-display font-bold text-sm tracking-wide rounded-md shadow-subtle hover:shadow-md transition-all flex items-center justify-center gap-2 focus:ring-4 focus:ring-pink-200 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="submit-btn-spinner" class="hidden">
            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </span>
          <span id="submit-btn-text">Generate Carpark Barcode</span>
          <svg id="submit-btn-arrow" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </div>

      <!-- Crucial IU CashCard Exit Reminder -->
      <div class="rounded-md bg-blue-50/80 border border-blue-200/60 p-2.5 text-[11px] text-blue-900 leading-snug flex items-start gap-2">
        <svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <strong class="font-bold">Exit Gantry Reminder:</strong> Remove your CashCard / NETS Motoring Card from your in-vehicle IU before scanning the complimentary barcode at the exit reader.
        </div>
      </div>

      <!-- Security / Privacy notice -->
      <div class="flex items-center justify-center gap-1.5 text-[11px] text-clementi-slate/80 text-center pt-0.5">
        <svg class="w-3 h-3 text-clementi-green flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" />
        </svg>
        <span>Zero PII storage: Vehicle registration numbers are hashed via HMAC-SHA256.</span>
      </div>
    </form>
  </div>

  <!-- SECTION 2: CODE 128 BARCODE RESULT SCREEN (Hidden until generated) -->
  <div id="barcode-result-section" class="hidden p-5 sm:p-6 space-y-5 text-center">
    <!-- Success Badge -->
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-50 border border-green-200 text-xs font-bold text-green-700 font-display">
      <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span>Voucher Approved — 2 Hours Complimentary</span>
    </div>

    <!-- Vehicle Plate Confirmation -->
    <div>
      <div class="text-xs text-clementi-slate uppercase tracking-wider font-display font-medium">Redemption for Vehicle</div>
      <div id="result-plate-display" class="text-2xl font-black text-clementi-charcoal tracking-widest font-display mt-0.5">SBA 1234 A</div>
    </div>

    <!-- High-Contrast Laser Scanner Barcode Card -->
    <div class="bg-white p-4 sm:p-6 rounded-lg border-2 border-clementi-charcoal shadow-md space-y-2">
      <div class="text-[10px] uppercase tracking-widest text-gray-500 font-display font-bold">Code 128 Laser Gantry Barcode</div>
      
      <!-- Pure Black on Pure White SVG Barcode Container -->
      <div class="w-full flex justify-center py-2 bg-white overflow-x-auto">
        <svg id="barcode-svg" class="max-w-full"></svg>
      </div>

      <div id="barcode-code-text" class="text-sm font-mono font-bold tracking-widest text-clementi-charcoal">
        CLM-12345678
      </div>
    </div>

    <!-- 15-Minute Countdown Expiry Timer -->
    <div class="rounded-md bg-amber-50 border border-amber-200 p-3 text-amber-900 text-xs space-y-1">
      <div class="font-bold flex items-center justify-center gap-1.5">
        <svg class="w-4 h-4 text-amber-700 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Barcode Valid For: <span id="countdown-timer" class="font-mono text-sm font-bold text-clementi-crimson">15:00</span></span>
      </div>
      <p class="text-[11px] text-amber-800/90 leading-tight">
        Scan this barcode directly at the car park exit scanner before exiting.
      </p>
    </div>

    <!-- Instructions & Action -->
    <div class="space-y-3 pt-2">
      <div class="rounded-md bg-blue-50 border border-blue-200/60 p-2.5 text-[11px] text-blue-900 text-left flex items-start gap-2">
        <svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <strong>At Gantry:</strong> Set screen brightness to 100%. Hold screen 10–15cm in front of the barcode reader.
        </div>
      </div>

      <button
        type="button"
        id="reset-redemption-btn"
        class="w-full py-3 px-4 bg-gray-100 hover:bg-gray-200 active:bg-gray-300 text-clementi-charcoal font-display font-bold text-xs tracking-wider uppercase rounded-md transition-all"
      >
        Claim Another Voucher
      </button>
    </div>
  </div>
</div>

<script>
  import JsBarcode from 'jsbarcode';

  // Constants & Config
  const MAX_INPUT_FILE_SIZE = 20 * 1024 * 1024; // 20 MB max raw upload size
  const MAX_IMAGE_WIDTH = 1200;
  const JPEG_QUALITY = 0.85;

  // DOM Elements
  const formSection = document.getElementById('redemption-form-section') as HTMLElement;
  const barcodeSection = document.getElementById('barcode-result-section') as HTMLElement;
  const plateInput = document.getElementById('vehicle-plate') as HTMLInputElement;
  const plateFeedback = document.getElementById('plate-feedback') as HTMLElement;
  const plateFeedbackText = document.getElementById('plate-feedback-text') as HTMLElement;
  const dropzone = document.getElementById('receipt-dropzone') as HTMLElement;
  const fileInput = document.getElementById('receipt-file-input') as HTMLInputElement;
  const dropzonePrompt = document.getElementById('dropzone-prompt') as HTMLElement;
  const dropzonePreview = document.getElementById('dropzone-preview') as HTMLElement;
  const previewThumbnail = document.getElementById('preview-thumbnail') as HTMLImageElement;
  const previewFilename = document.getElementById('preview-filename') as HTMLElement;
  const previewBadge = document.getElementById('preview-badge') as HTMLElement;
  const retakeBtn = document.getElementById('retake-receipt-btn') as HTMLButtonElement;
  const submitBtn = document.getElementById('submit-redemption-btn') as HTMLButtonElement;
  const submitSpinner = document.getElementById('submit-btn-spinner') as HTMLElement;
  const submitText = document.getElementById('submit-btn-text') as HTMLElement;
  const submitArrow = document.getElementById('submit-btn-arrow') as HTMLElement;
  const errorBanner = document.getElementById('error-banner') as HTMLElement;
  const errorMessage = document.getElementById('error-banner-message') as HTMLElement;
  const barcodeSvg = document.getElementById('barcode-svg') as SVGSVGElement;
  const barcodeCodeText = document.getElementById('barcode-code-text') as HTMLElement;
  const resultPlateDisplay = document.getElementById('result-plate-display') as HTMLElement;
  const countdownTimer = document.getElementById('countdown-timer') as HTMLElement;
  const resetBtn = document.getElementById('reset-redemption-btn') as HTMLButtonElement;

  // State
  let downsampledBlob: Blob | null = null;
  let currentPreviewUrl: string | null = null;
  let isPlateValid = false;
  let countdownTimerId: number | null = null;

  // ============================================================================
  // 1. LTA MOD-19 VEHICLE PLATE VALIDATION
  // ============================================================================
  function calculateMOD19(prefix: string, digits: string): string {
    const letterValue = (letter: string) => letter.charCodeAt(0) - 64;
    const p1 = letterValue(prefix[0]) * 9;
    const p2 = letterValue(prefix[1]) * 4;
    const p3 = letterValue(prefix[2]) * 5;
    const num = parseInt(digits, 10);
    const sum = p1 + p2 + p3 + num;
    const remainder = sum % 19;
    const checksumMap = 'AZYXUTSRPMLKJHGEDCB';
    return checksumMap[remainder];
  }

  function validateLTAPlate(plate: string): boolean {
    const cleanPlate = plate.trim().toUpperCase().replace(/\s+/g, '');
    const plateRegex = /^([A-Z]{3})(\d{1,4})([A-Z])$/;
    const match = cleanPlate.match(plateRegex);
    if (!match) return false;
    const prefix = match[1];
    const digits = match[2];
    const checksum = match[3];
    return checksum === calculateMOD19(prefix, digits);
  }

  plateInput.addEventListener('input', () => {
    const rawVal = plateInput.value.toUpperCase();
    plateInput.value = rawVal;
    hideError();

    const clean = rawVal.trim().replace(/\s+/g, '');
    if (clean.length === 0) {
      plateInput.classList.remove('border-green-500', 'border-red-500');
      plateFeedbackText.textContent = 'Validated with LTA MOD-19 checksum (1 pass per vehicle / patron per day).';
      plateFeedback.className = 'text-[11px] text-clementi-slate mt-1.5 flex items-center gap-1 transition-colors';
      isPlateValid = false;
      return;
    }

    if (clean.length >= 5) {
      if (validateLTAPlate(clean)) {
        plateInput.classList.remove('border-red-500', 'border-clementi-border');
        plateInput.classList.add('border-green-500');
        plateFeedbackText.textContent = 'Valid Singapore vehicle plate (Checksum verified).';
        plateFeedback.className = 'text-[11px] text-green-700 mt-1.5 flex items-center gap-1 transition-colors font-medium';
        isPlateValid = true;
      } else {
        plateInput.classList.remove('border-green-500', 'border-clementi-border');
        plateInput.classList.add('border-red-500');
        plateFeedbackText.textContent = 'Invalid Singapore plate format or checksum.';
        plateFeedback.className = 'text-[11px] text-red-600 mt-1.5 flex items-center gap-1 transition-colors';
        isPlateValid = false;
      }
    } else {
      isPlateValid = false;
    }
  });

  // ============================================================================
  // 2. HTML5 CANVAS DOWNSAMPLING (Hardened against DoS & Memory Bloat)
  // ============================================================================
  async function downsampleImage(file: File): Promise<Blob> {
    if (!file.type.startsWith('image/')) {
      throw new Error('Invalid file type. Please upload a standard image file (JPEG, PNG, WEBP).');
    }
    if (file.size > MAX_INPUT_FILE_SIZE) {
      throw new Error('Image file too large (max 20 MB). Please take a photo directly with your camera.');
    }

    return new Promise((resolve, reject) => {
      const objectUrl = URL.createObjectURL(file);
      const img = new Image();

      img.onload = () => {
        URL.revokeObjectURL(objectUrl);

        // Decompression bomb / extreme dimension guard
        if (img.width > 12000 || img.height > 12000) {
          reject(new Error('Image dimensions exceed safety limit.'));
          return;
        }

        let width = img.width;
        let height = img.height;

        if (width > MAX_IMAGE_WIDTH) {
          height = Math.round((height * MAX_IMAGE_WIDTH) / width);
          width = MAX_IMAGE_WIDTH;
        }

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;

        const ctx = canvas.getContext('2d');
        if (!ctx) {
          reject(new Error('Canvas 2D context unavailable'));
          return;
        }

        ctx.drawImage(img, 0, 0, width, height);
        canvas.toBlob(
          (blob) => {
            // Free canvas memory buffer
            canvas.width = 0;
            canvas.height = 0;

            if (blob) {
              resolve(blob);
            } else {
              reject(new Error('Canvas image compression failed'));
            }
          },
          'image/jpeg',
          JPEG_QUALITY
        );
      };

      img.onerror = () => {
        URL.revokeObjectURL(objectUrl);
        reject(new Error('Failed to load receipt image for compression'));
      };

      img.src = objectUrl;
    });
  }

  // Dropzone click triggers file picker
  dropzone.addEventListener('click', (e) => {
    if (e.target !== retakeBtn) {
      fileInput.click();
    }
  });

  retakeBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput.value = '';
    fileInput.click();
  });

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;

    hideError();
    try {
      downsampledBlob = await downsampleImage(file);
      const sizeKB = Math.round(downsampledBlob.size / 1024);

      if (currentPreviewUrl) {
        URL.revokeObjectURL(currentPreviewUrl);
      }
      currentPreviewUrl = URL.createObjectURL(downsampledBlob);
      previewThumbnail.src = currentPreviewUrl;
      previewFilename.textContent = file.name;
      previewBadge.textContent = `Compressed: ${sizeKB} KB (JPEG)`;

      dropzonePrompt.classList.add('hidden');
      dropzonePreview.classList.remove('hidden');
    } catch (err: any) {
      console.error('Downsampling failed:', err);
      showError(err.message || 'Failed to process receipt image. Please try another photo.');
    }
  });

  // ============================================================================
  // 3. SUBMIT & BARCODE GENERATION
  // ============================================================================
  submitBtn.addEventListener('click', async () => {
    const rawPlate = plateInput.value.trim().toUpperCase();
    if (!rawPlate) {
      showError('Please enter your vehicle registration number.');
      plateInput.focus();
      return;
    }

    if (!isPlateValid && !validateLTAPlate(rawPlate)) {
      showError('Please enter a valid Singapore vehicle plate (e.g. SBA 1234 A).');
      plateInput.focus();
      return;
    }

    if (!downsampledBlob) {
      showError('Please snap or upload your mall receipt photo.');
      fileInput.click();
      return;
    }

    // Set Loading state
    setLoading(true);
    hideError();

    try {
      // Check operating hours client-side (12:00 - 15:00 SGT weekdays)
      const sgtDate = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Singapore' }));
      const day = sgtDate.getDay(); // 0 is Sunday, 6 is Saturday
      const hour = sgtDate.getHours();

      // Send to n8n webhook or staging endpoint
      const webhookUrl = (window as any).CLEMENTI_WEBHOOK_URL || (import.meta.env.PUBLIC_REDEMPTION_WEBHOOK_URL) || '/api/v1/redemption';
      const formData = new FormData();
      formData.append('receipt', downsampledBlob, 'receipt.jpg');
      formData.append('vehiclePlate', rawPlate);
      formData.append('timestamp', new Date().toISOString());

      let voucherCode: string;
      try {
        const response = await fetch(webhookUrl, {
          method: 'POST',
          body: formData,
        });

        if (!response.ok) {
          let errorMsg = 'Receipt verification failed. Please try again.';
          try {
            const errJson = await response.json();
            errorMsg = errJson.message || errJson.error || errorMsg;
          } catch {
            if (response.status === 400) {
              errorMsg = 'Receipt does not qualify. Minimum $30 same-day spend required.';
            } else if (response.status === 403) {
              errorMsg = 'Redemptions are only valid between 12:00 PM – 3:00 PM on weekdays.';
            } else if (response.status === 429) {
              errorMsg = 'Too many requests. Please wait a minute before retrying.';
            }
          }
          showError(errorMsg);
          return;
        }

        const resJson = await response.json();
        voucherCode = resJson.voucher_code || resJson.voucherCode;
        if (!voucherCode) {
          showError('Invalid server response: No voucher code returned.');
          return;
        }
      } catch (networkErr: any) {
        // Only allow fallback code in explicit client mock preview mode
        if ((window as any).CLEMENTI_MOCK_PREVIEW) {
          voucherCode = `321CLM${Date.now().toString().slice(-8)}`;
        } else {
          showError('Unable to connect to verification service. Please check network connection.');
          return;
        }
      }

      // Transition to Barcode Screen
      renderBarcodeScreen(voucherCode, rawPlate);
    } catch (err: any) {
      showError(err.message || 'Verification failed. Please try again.');
    } finally {
      setLoading(false);
    }
  });

  function renderBarcodeScreen(code: string, plate: string) {
    formSection.classList.add('hidden');
    barcodeSection.classList.remove('hidden');

    resultPlateDisplay.textContent = plate;
    barcodeCodeText.textContent = code;

    // Render high-contrast Code 128 barcode
    JsBarcode(barcodeSvg, code, {
      format: 'CODE128',
      width: 2.2,
      height: 90,
      displayValue: false,
      margin: 12,
      background: '#FFFFFF',
      lineColor: '#000000',
    });

    // Screen wake lock for carpark exit
    if ('wakeLock' in navigator) {
      navigator.wakeLock.request('screen').catch(() => {});
    }

    // 15-minute countdown
    startCountdown(15 * 60);
  }

  function startCountdown(seconds: number) {
    if (countdownTimerId) clearInterval(countdownTimerId);
    let remaining = seconds;

    const tick = () => {
      const m = Math.floor(remaining / 60);
      const s = remaining % 60;
      countdownTimer.textContent = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
      if (remaining <= 0) {
        if (countdownTimerId) clearInterval(countdownTimerId);
        countdownTimer.textContent = 'EXPIRED';
      }
      remaining--;
    };

    tick();
    countdownTimerId = window.setInterval(tick, 1000);
  }

  resetBtn.addEventListener('click', () => {
    if (countdownTimerId) clearInterval(countdownTimerId);
    barcodeSection.classList.add('hidden');
    formSection.classList.remove('hidden');

    // Reset fields
    if (currentPreviewUrl) {
      URL.revokeObjectURL(currentPreviewUrl);
      currentPreviewUrl = null;
    }
    plateInput.value = '';
    plateInput.classList.remove('border-green-500', 'border-red-500');
    fileInput.value = '';
    downsampledBlob = null;
    dropzonePreview.classList.add('hidden');
    dropzonePrompt.classList.remove('hidden');
    hideError();
  });

  function showError(msg: string) {
    errorMessage.textContent = msg;
    errorBanner.classList.remove('hidden');
    errorBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideError() {
    errorBanner.classList.add('hidden');
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    if (loading) {
      submitSpinner.classList.remove('hidden');
      submitArrow.classList.add('hidden');
      submitText.textContent = 'Processing Receipt...';
    } else {
      submitSpinner.classList.add('hidden');
      submitArrow.classList.remove('hidden');
      submitText.textContent = 'Generate Carpark Barcode';
    }
  }
</script>
