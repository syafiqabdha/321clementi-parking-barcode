---
// Mobile-first card container optimized for basement mall lighting.
// High contrast (WCAG AAA for text), clear touch targets, and resilient visibility.
// Implements client-side HTML5 canvas downsampling, shop directory select from API,
// click-to-enlarge barcode modal, and claim history & recovery state machine.
import BarcodeModal from './BarcodeModal.astro';
import ClaimHistoryModal from './ClaimHistoryModal.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div
  class="w-full bg-clementi-white rounded-2xl border border-clementi-border shadow-card overflow-hidden transition-all mb-5 relative"
  data-testid="redemption-card-container"
>
  <!-- 321 Clementi Brand Ribbon (6-color spectrum top accent) -->
  <div class="h-1.5 w-full flex" aria-hidden="true">
    <div class="h-full flex-1 bg-[#71BF45]" title="Fresh Leaf Green"></div>
    <div class="h-full flex-1 bg-[#38BEDD]" title="Coastal Cyan"></div>
    <div class="h-full flex-1 bg-[#A87FB7]" title="Wisteria Lavender"></div>
    <div class="h-full flex-1 bg-[#EF5A92]" title="Blossom Pink"></div>
    <div class="h-full flex-1 bg-[#ED1651]" title="Clementi Crimson"></div>
    <div class="h-full flex-1 bg-[#F47820]" title="Tangerine Orange"></div>
  </div>

  <!-- SECTION 1: INTAKE & REDEMPTION FORM (Active State) -->
  <div id="redemption-form-section" class="p-5 sm:p-6 space-y-5">
    <!-- Card Heading -->
    <div class="text-left">
      <div class="flex items-center gap-1.5 mb-1">
        <span class="w-1.5 h-1.5 rounded-full bg-clementi-crimson"></span>
        <span class="text-xs font-bold text-clementi-crimson uppercase tracking-wider font-display">
          Free 2 hours Parking Redemption
        </span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-clementi-charcoal font-display tracking-tight">
        Claim Parking Voucher
      </h2>
      <p class="text-xs sm:text-sm text-clementi-slate mt-1 font-body leading-relaxed">
        Select your store and snap your same-day qualifying receipt to receive an instant 2-hour free parking voucher barcode to scan at the exit gantry.
      </p>
    </div>

    <!-- Error Alert Banner (Hidden by default) -->
    <div
      id="error-banner"
      class="hidden rounded-xl bg-red-50 border border-red-200 p-3.5 text-xs text-red-800 flex items-start gap-2.5 shadow-xs"
      role="alert"
    >
      <span class="material-symbols-outlined text-red-600 text-lg flex-shrink-0 mt-0.5 fill-1" style="font-variation-settings: 'FILL' 1;">error</span>
      <div id="error-banner-message" class="font-medium flex-1">Please correct the highlighted errors.</div>
    </div>

    <!-- Intake Form -->
    <form id="redemption-form" class="space-y-4" onsubmit="return false;">
      <!-- Step 2: Shop Selection (Required Dropdown per PAN-75 / ADR-001) -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="shop-select" class="block text-xs font-bold uppercase tracking-wider text-clementi-charcoal font-display">
            Qualifying Mall Store <span class="text-clementi-crimson" aria-hidden="true">*</span>
          </label>
          <span class="text-[11px] text-slate-500 font-medium" id="shop-count-label">
            Loading stores...
          </span>
        </div>
        <div class="relative flex rounded-xl shadow-xs overflow-hidden">
          <span class="inline-flex items-center px-3.5 bg-slate-100 border-2 border-r-0 border-clementi-border text-clementi-slate select-none">
            <span class="material-symbols-outlined text-lg">storefront</span>
          </span>
          <select
            id="shop-select"
            name="shopId"
            class="block w-full rounded-none rounded-r-xl border-2 border-clementi-border bg-clementi-subtle px-3 py-3 text-sm font-display font-medium text-clementi-charcoal focus:border-clementi-crimson focus:ring-1 focus:ring-clementi-pink focus:outline-none transition-colors appearance-none cursor-pointer"
            required
          >
            <option value="" disabled selected>-- Select Store from Receipt --</option>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-clementi-slate">
            <span class="material-symbols-outlined text-lg">expand_more</span>
          </div>
        </div>
        <div class="text-[11px] text-clementi-slate mt-1 flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm text-clementi-slate/80 flex-shrink-0">check</span>
          <span>Receipt spend must originate from an eligible retail tenant.</span>
        </div>
      </div>

      <!-- Step 3: Receipt Upload Preview & Trigger -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label class="block text-xs font-bold uppercase tracking-wider text-clementi-charcoal font-display">
            Proof of Spend (Receipt Photo) <span class="text-clementi-crimson" aria-hidden="true">*</span>
          </label>
          <span class="text-[11px] text-clementi-crimson font-bold bg-pink-50 border border-pink-100 px-2 py-0.5 rounded">
            Min. $30 spend
          </span>
        </div>
        
        <!-- Dropzone / Camera Trigger -->
        <div
          id="receipt-dropzone"
          class="relative border-2 border-dashed border-clementi-border hover:border-clementi-crimson rounded-xl p-5 bg-[#FDFEFE] text-center transition-all cursor-pointer group flex flex-col items-center justify-center gap-2"
          role="button"
          tabindex="0"
          aria-label="Upload or snap mall receipt"
        >
          <input
            type="file"
            id="receipt-file-input"
            accept="image/*"
            capture="environment"
            class="sr-only"
            aria-hidden="true"
          />

          <!-- Default State (Prompt) -->
          <div id="dropzone-prompt" class="flex flex-col items-center justify-center py-2 space-y-2">
            <div class="w-12 h-12 rounded-full bg-pink-50 text-clementi-crimson flex items-center justify-center group-hover:scale-105 transition-transform shadow-xs">
              <span class="material-symbols-outlined text-2xl">photo_camera</span>
            </div>
            <div>
              <span class="text-sm font-bold text-clementi-charcoal font-display group-hover:text-clementi-crimson transition-colors block">
                Tap to snap or upload receipt
              </span>
              <span class="text-xs text-clementi-slate mt-0.5 block">
                Supports JPG, PNG (Max 20MB) • Clear store name, date & amount required
              </span>
            </div>
          </div>

          <!-- Preview State (Shown when photo selected) -->
          <div id="dropzone-preview" class="hidden w-full flex items-center gap-3 py-1">
            <div class="relative w-14 h-14 rounded-lg overflow-hidden bg-gray-100 flex-shrink-0 border border-clementi-border">
              <img id="preview-thumbnail" src="" alt="Receipt thumbnail" class="w-full h-full object-cover" />
            </div>
            <div class="flex-1 text-left min-w-0">
              <p id="preview-filename" class="text-xs font-bold text-clementi-charcoal truncate font-display">receipt.jpg</p>
              <div class="flex items-center gap-2 mt-1">
                <span id="preview-badge" class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-green-100 text-green-800">
                  Compressed: ~200 KB
                </span>
                <span class="text-[11px] text-clementi-green font-bold">✓ Attached</span>
              </div>
            </div>
            <button
              type="button"
              id="retake-receipt-btn"
              class="text-xs font-bold text-clementi-crimson hover:underline px-2.5 py-1 rounded bg-pink-50"
            >
              Retake
            </button>
          </div>
        </div>

        <!-- Store Exclusions Note -->
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-[11px] text-amber-900 leading-relaxed flex items-start gap-2">
          <span class="material-symbols-outlined text-amber-700 text-base shrink-0 mt-0.5">warning</span>
          <p>
            <strong>Exclusions:</strong> Excludes pushcarts, pop-up kiosks, bill payments, money changer receipts, Clementi Family & Aesthetic Clinic, and GynaeMD Women's Clinic.
          </p>
        </div>
      </div>

      
      <!-- Cloudflare Turnstile -->
      {turnstileSiteKey && (
        <div class="flex justify-center pt-2">
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
          <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
        </div>
      )}

      <!-- Action Button (Clementi Crimson #ED1651) -->
      <div class="pt-1">
        <button
          type="button"
          id="submit-redemption-btn"
          class="w-full py-3.5 px-5 bg-action-primary hover:bg-action-hover active:scale-[0.99] text-clementi-white font-display font-bold text-sm tracking-wide rounded-xl shadow-md transition-all flex items-center justify-center gap-2 focus:ring-4 focus:ring-pink-200 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="submit-btn-spinner" class="hidden">
            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </span>
          <span id="submit-btn-icon" class="material-symbols-outlined text-lg">qr_code_scanner</span>
          <span id="submit-btn-text">Generate Carpark Barcode</span>
          <span id="submit-btn-arrow" class="material-symbols-outlined text-base">arrow_forward</span>
        </button>
      </div>

      <!-- Recovery / History Shortcut -->
      <div class="text-center pt-1 pb-1">
        <button
          type="button"
          id="open-history-shortcut-btn"
          class="text-xs font-display font-medium text-clementi-crimson hover:underline inline-flex items-center gap-1"
        >
          <span class="material-symbols-outlined text-sm">history</span>
          <span>Lost your barcode or need to unclaim? Search Claim History & Recovery</span>
        </button>
      </div>

      <!-- Crucial IU CashCard Exit Reminder -->
      <div class="rounded-xl bg-blue-50/80 border border-blue-200/60 p-3 text-[11px] text-blue-900 leading-snug flex items-start gap-2.5">
        <span class="material-symbols-outlined text-blue-600 text-base shrink-0 mt-0.5">info</span>
        <div>
          <strong class="font-bold">Exit Gantry Reminder:</strong> Remove your CashCard / NETS Motoring Card from your in-vehicle IU before scanning the complimentary barcode at the exit reader.
        </div>
      </div>
    </form>
  </div>

  <!-- SECTION 1B: PORTAL CLOSED STATE -->
  <div id="redemption-closed-section" class="hidden p-5 sm:p-6 space-y-5">
    <div class="text-left space-y-1">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-100 border border-red-200 text-clementi-crimson text-xs font-bold tracking-wider font-display">
        <span class="w-2 h-2 rounded-full bg-clementi-crimson animate-pulse"></span>
        <span>SYSTEM OFFLINE • 12:00 PM – 3:00 PM ONLY</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-clementi-crimson font-display tracking-tight mt-1">
        Redemption Currently Closed
      </h2>
      <p class="text-xs sm:text-sm text-clementi-slate font-body">
        Automated 2-Hour Carpark Fee Waiver is available weekdays 12:00 PM – 3:00 PM.
      </p>
    </div>

    <!-- Closed State Alert Box -->
    <div class="bg-red-50/90 border border-red-200 rounded-xl p-4 flex items-start gap-3 shadow-xs">
      <span class="material-symbols-outlined text-clementi-crimson text-2xl flex-shrink-0 mt-0.5 fill-1" style="font-variation-settings: 'FILL' 1;">error</span>
      <div class="space-y-1">
        <h3 class="font-display text-sm text-red-900 font-bold leading-snug">
          Redemption Unavailable
        </h3>
        <p class="text-xs text-red-800 leading-relaxed font-body">
          The automated carpark redemption portal is closed outside operating hours. Please return between <strong>12:00 PM – 3:00 PM (Monday to Friday)</strong> to scan your receipts and redeem your 2-hour waiver.
        </p>
      </div>
    </div>

    <!-- Tester Switch -->
    <div class="text-center pt-2">
      <button
        type="button"
        id="closed-mode-override-btn"
        class="text-xs text-clementi-crimson underline font-medium hover:text-action-hover"
      >
        Tester Switch: Open Intake Form (Preview Mode)
      </button>
    </div>
  </div>

  <!-- SECTION 2: TACTILE PARKING TICKET PASS BARCODE RESULT (Hidden until generated) -->
  <div id="barcode-result-section" class="hidden p-5 sm:p-6 space-y-5 text-center">
    <!-- Header Status Tag -->
    <div class="inline-flex items-center gap-1.5 bg-green-50 border border-green-200 text-green-700 font-bold px-3 py-1 rounded-full text-xs mx-auto shadow-xs font-display">
      <span class="material-symbols-outlined text-green-600 fill-1 text-base leading-none" style="font-variation-settings: 'FILL' 1;">check_circle</span>
      <span>VOUCHER ISSUED • 2 HOURS COMPLIMENTARY</span>
    </div>

    <!-- Tactile Perforation Divider with Circular Cutout Notches -->
    <div class="relative my-4 -mx-5 sm:-mx-6" aria-hidden="true">
      <div class="absolute -left-3.5 -top-3 w-6 h-6 bg-clementi-subtle rounded-full border-r border-clementi-border shadow-inner"></div>
      <div class="border-b-2 border-dashed border-slate-300 w-full"></div>
      <div class="absolute -right-3.5 -top-3 w-6 h-6 bg-clementi-subtle rounded-full border-l border-clementi-border shadow-inner"></div>
    </div>

    <!-- High-Contrast Laser Scanner Barcode Coupon Box (Click to Enlarge per PAN-75) -->
    <div
      id="barcode-box-trigger"
      class="bg-white border-2 border-slate-800 rounded-xl p-4 shadow-sm space-y-2 flex flex-col items-center cursor-zoom-in group hover:border-clementi-crimson transition-all relative"
      role="button"
      tabindex="0"
      aria-label="Click to enlarge barcode for gantry scanning"
    >
      <div class="flex items-center justify-between w-full text-[11px] font-bold text-slate-700 tracking-wider uppercase font-display">
        <div class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-base text-clementi-crimson leading-none">qr_code_scanner</span>
          <span>PARKING VOUCHER BARCODE</span>
        </div>
        <span class="text-[10px] text-clementi-crimson font-bold bg-pink-50 px-2 py-0.5 rounded flex items-center gap-1 group-hover:scale-105 transition-transform">
          <span class="material-symbols-outlined text-xs">zoom_in</span> Tap to Enlarge
        </span>
      </div>
      
      <!-- Barcode Container -->
      <div class="w-full flex justify-center py-2 px-1 bg-white overflow-x-auto">
        <svg id="barcode-svg" class="max-w-full"></svg>
      </div>

      <!-- Hidden canvas used for PNG export (mobile gallery compatible) -->
      <canvas
        id="barcode-download-canvas"
        class="fixed top-0 left-0 -z-50 opacity-0 pointer-events-none"
        aria-hidden="true"
      ></canvas>

      <div id="barcode-code-text" class="font-mono font-black text-base sm:text-lg tracking-widest text-slate-950 mt-1 select-all">
        0000000000
      </div>
    </div>

    <!-- EOD Validity Banner (replaces 15-min countdown) -->
    <div class="rounded-xl p-3.5 bg-green-50 border border-green-200 text-left flex items-center gap-2.5">
      <div class="text-green-600 shrink-0">
        <span class="material-symbols-outlined text-xl">check_circle</span>
      </div>
      <div>
        <div class="text-xs font-bold text-green-900 font-display">Valid until 23:59 today</div>
        <div class="text-[11px] text-green-800 font-body">Scan at car park exit gantry anytime today.</div>
      </div>
    </div>

    <!-- Instructions Notice -->
    <div class="rounded-xl p-3 bg-blue-50 border border-blue-200/80 text-left flex items-start gap-2.5 text-xs text-blue-900 leading-relaxed">
      <span class="material-symbols-outlined text-blue-600 shrink-0 text-base mt-0.5">info</span>
      <div>
        <strong class="font-bold text-blue-950">At Gantry:</strong> Set screen brightness to 100%. Tap barcode above to open full-screen scanner mode. Hold screen 10–15cm in front of optical reader.
      </div>
    </div>

    <!-- Quick Actions Grid (Unclaim Voucher & Reset) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
      <button
        type="button"
        id="pass-unclaim-btn"
        class="flex items-center justify-center gap-1.5 rounded-xl py-3 px-4 font-display font-bold text-xs tracking-wider uppercase text-red-700 bg-red-50 hover:bg-red-100 active:bg-red-200 border border-red-200 transition-all shadow-xs"
      >
        <span class="material-symbols-outlined text-base">undo</span>
        <span>Unclaim / Release</span>
      </button>

      <button
        type="button"
        id="reset-redemption-btn"
        class="flex items-center justify-center gap-1.5 rounded-xl py-3 px-4 font-display font-bold text-xs tracking-wider uppercase text-slate-700 bg-slate-100 hover:bg-slate-200 active:bg-slate-300 border border-slate-300 transition-all shadow-xs"
      >
        <span class="material-symbols-outlined text-base">home</span>
        <span>Back to Home</span>
      </button>
    </div>

    <!-- Download Barcode (Canvas-to-PNG for mobile gallery compatibility) -->
    <div class="pt-1">
      <button
        type="button"
        id="download-barcode-btn"
        class="w-full flex items-center justify-center gap-1.5 rounded-xl py-3 px-4 font-display font-bold text-xs tracking-wider uppercase text-white bg-slate-900 hover:bg-slate-800 active:bg-slate-700 border border-slate-900 transition-all shadow-xs"
      >
        <span class="material-symbols-outlined text-base">download</span>
        <span>Download Barcode</span>
      </button>
    </div>
  </div>

  <!-- Shared Modals -->
  <BarcodeModal />
  <ClaimHistoryModal />
</div>

<script>
  import JsBarcode from 'jsbarcode';
  import { fetchEligibleShops } from './shops-data';
  import type { ShopItem, ClaimHistoryRecord } from '../types';

  // Constants & Config
  const MAX_INPUT_FILE_SIZE = 20 * 1024 * 1024;
  const MAX_IMAGE_WIDTH = 1200;
  const JPEG_QUALITY = 0.85;

  // DOM Elements - Main Form
  const formSection = document.getElementById('redemption-form-section') as HTMLElement;
  const closedSection = document.getElementById('redemption-closed-section') as HTMLElement;
  const barcodeSection = document.getElementById('barcode-result-section') as HTMLElement;
  const shopSelect = document.getElementById('shop-select') as HTMLSelectElement;
  const shopCountLabel = document.getElementById('shop-count-label') as HTMLElement;
  const dropzone = document.getElementById('receipt-dropzone') as HTMLElement;
  const fileInput = document.getElementById('receipt-file-input') as HTMLInputElement;
  const dropzonePrompt = document.getElementById('dropzone-prompt') as HTMLElement;
  const dropzonePreview = document.getElementById('dropzone-preview') as HTMLElement;
  const previewThumbnail = document.getElementById('preview-thumbnail') as HTMLImageElement;
  const previewFilename = document.getElementById('preview-filename') as HTMLElement;
  const previewBadge = document.getElementById('preview-badge') as HTMLElement;
  const retakeBtn = document.getElementById('retake-receipt-btn') as HTMLButtonElement;
  const submitBtn = document.getElementById('submit-redemption-btn') as HTMLButtonElement;
  const submitSpinner = document.getElementById('submit-btn-spinner') as HTMLElement;
  const submitIcon = document.getElementById('submit-btn-icon') as HTMLElement;
  const submitText = document.getElementById('submit-btn-text') as HTMLElement;
  const submitArrow = document.getElementById('submit-btn-arrow') as HTMLElement;
  const errorBanner = document.getElementById('error-banner') as HTMLElement;
  const errorMessage = document.getElementById('error-banner-message') as HTMLElement;
  const barcodeSvg = document.getElementById('barcode-svg') as unknown as SVGSVGElement;
  const barcodeCodeText = document.getElementById('barcode-code-text') as HTMLElement;
  const downloadBarcodeBtn = document.getElementById('download-barcode-btn') as HTMLButtonElement;
  const downloadCanvas = document.getElementById('barcode-download-canvas') as HTMLCanvasElement;
  const resetBtn = document.getElementById('reset-redemption-btn') as HTMLButtonElement;
  const passUnclaimBtn = document.getElementById('pass-unclaim-btn') as HTMLButtonElement;
  const barcodeBoxTrigger = document.getElementById('barcode-box-trigger') as HTMLElement;
  const openHistoryShortcutBtn = document.getElementById('open-history-shortcut-btn') as HTMLButtonElement;

  // DOM Elements - Enlarge Modal
  const enlargeModal = document.getElementById('barcode-enlarge-modal') as HTMLElement;
  const closeEnlargeModalBtn = document.getElementById('close-enlarge-modal-btn') as HTMLButtonElement;
  const dismissEnlargeBtn = document.getElementById('dismiss-enlarge-btn') as HTMLButtonElement;
  const enlargeBarcodeSvg = document.getElementById('enlarge-barcode-svg') as unknown as SVGSVGElement;
  const enlargeBarcodeText = document.getElementById('enlarge-barcode-text') as HTMLElement;
  const wakeLockBadge = document.getElementById('enlarge-wake-lock-badge') as HTMLElement;

  // DOM Elements - Claim History Drawer
  const historyModal = document.getElementById('claim-history-modal') as HTMLElement;
  const closeHistoryDrawerBtn = document.getElementById('close-history-drawer-btn') as HTMLButtonElement;
  const historyReceiptInput = document.getElementById('history-receipt-input') as HTMLInputElement;
  const historySearchBtn = document.getElementById('history-search-btn') as HTMLButtonElement;
  const historyAlertBanner = document.getElementById('history-alert-banner') as HTMLElement;
  const historyAlertText = document.getElementById('history-alert-text') as HTMLElement;
  const historyLoadingSpinner = document.getElementById('history-loading-spinner') as HTMLElement;
  const historyEmptyState = document.getElementById('history-empty-state') as HTMLElement;
  const historyResultsList = document.getElementById('history-results-list') as HTMLElement;
  const fallbackUnclaimSection = document.getElementById('fallback-unclaim-section') as HTMLElement;
  const fallbackSpendInput = document.getElementById('fallback-spend-input') as HTMLInputElement;
  const fallbackShopSelect = document.getElementById('fallback-shop-select') as HTMLSelectElement;
  const cancelFallbackBtn = document.getElementById('cancel-fallback-btn') as HTMLButtonElement;
  const confirmFallbackBtn = document.getElementById('confirm-fallback-btn') as HTMLButtonElement;

  // State
  let loadedShops: ShopItem[] = [];
  let downsampledBlob: Blob | null = null;
  let currentPreviewUrl: string | null = null;
  let currentVoucherCode: string = '';
  let currentReceiptNumber: string = '';
  let currentRedemptionId: string = '';
  let pendingUnclaimRecord: ClaimHistoryRecord | null = null;
  let wakeLockSentinel: WakeLockSentinel | null = null;

  // Initialize Shops Directory
  async function initShops() {
    loadedShops = await fetchEligibleShops();
    populateShopDropdowns(loadedShops);
  }

  function populateShopDropdowns(shops: ShopItem[]) {
    if (!shopSelect) return;
    shopSelect.innerHTML = '<option value="" disabled selected>-- Select Store from Receipt --</option>';

    // Flatten and sort: level order (B1, L1, L2, ...) then alphabetically by name
    const levelOrder: Record<string, number> = { B3: 0, B2: 1, B1: 2, L1: 3, L2: 4, L3: 5, L4: 6, L5: 7, L6: 8, L7: 9 };
    const sorted = [...shops].sort((a, b) => {
      const la = levelOrder[a.level] ?? 99;
      const lb = levelOrder[b.level] ?? 99;
      if (la !== lb) return la - lb;
      return a.name.localeCompare(b.name);
    });

    sorted.forEach((shop) => {
      const opt = document.createElement('option');
      opt.value = shop.id;
      opt.textContent = `${shop.level} : ${shop.name}`;
      shopSelect.appendChild(opt);
    });

    if (shopCountLabel) {
      shopCountLabel.textContent = `${shops.length} eligible stores`;
    }

    // Also populate fallback unclaim shop select (flat, same order)
    if (fallbackShopSelect) {
      fallbackShopSelect.innerHTML = '<option value="">Select qualifying shop...</option>';
      sorted.forEach((shop) => {
        const opt = document.createElement('option');
        opt.value = shop.id;
        opt.textContent = `${shop.level} : ${shop.name}`;
        fallbackShopSelect.appendChild(opt);
      });
    }
  }

  initShops();

    // ============================================================================
  // 2. IMAGE DOWNSAMPLING
  // ============================================================================
  async function downsampleImage(file: File): Promise<Blob> {
    if (!file.type.startsWith('image/')) {
      throw new Error('Invalid file type. Please upload a standard image file (JPEG, PNG, WEBP).');
    }
    if (file.size > MAX_INPUT_FILE_SIZE) {
      throw new Error('Image file too large (max 20 MB). Please take a photo directly with your camera.');
    }

    return new Promise((resolve, reject) => {
      const objectUrl = URL.createObjectURL(file);
      const img = new Image();

      img.onload = () => {
        URL.revokeObjectURL(objectUrl);
        if (img.width > 12000 || img.height > 12000) {
          reject(new Error('Image dimensions exceed safety limit.'));
          return;
        }

        let width = img.width;
        let height = img.height;
        if (width > MAX_IMAGE_WIDTH) {
          height = Math.round((height * MAX_IMAGE_WIDTH) / width);
          width = MAX_IMAGE_WIDTH;
        }

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        if (!ctx) {
          reject(new Error('Canvas 2D context unavailable'));
          return;
        }

        ctx.drawImage(img, 0, 0, width, height);
        canvas.toBlob(
          (blob) => {
            canvas.width = 0;
            canvas.height = 0;
            if (blob) resolve(blob);
            else reject(new Error('Canvas compression failed'));
          },
          'image/jpeg',
          JPEG_QUALITY
        );
      };

      img.onerror = () => {
        URL.revokeObjectURL(objectUrl);
        reject(new Error('Failed to load receipt image for compression'));
      };

      img.src = objectUrl;
    });
  }

  dropzone?.addEventListener('click', (e) => {
    if (e.target !== retakeBtn) fileInput.click();
  });

  retakeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput.value = '';
    fileInput.click();
  });

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    hideError();
    try {
      downsampledBlob = await downsampleImage(file);
      const sizeKB = Math.round(downsampledBlob.size / 1024);
      if (currentPreviewUrl) URL.revokeObjectURL(currentPreviewUrl);
      currentPreviewUrl = URL.createObjectURL(downsampledBlob);
      previewThumbnail.src = currentPreviewUrl;
      previewFilename.textContent = file.name.length > 24 ? file.name.substring(0, 21) + '...' : file.name;
      previewBadge.textContent = `Compressed: ${sizeKB} KB (JPEG)`;
      dropzonePrompt.classList.add('hidden');
      dropzonePreview.classList.remove('hidden');
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Failed to process receipt photo.';
      showError(msg);
    }
  });

  // ============================================================================
  // 3. SUBMIT CLAIM FORM
  // ============================================================================
  submitBtn?.addEventListener('click', async () => {
    const selectedShopId = shopSelect.value;
    if (!selectedShopId) {
      showError('Please select the qualifying store where you made your purchase.');
      shopSelect.focus();
      return;
    }

    if (!downsampledBlob) {
      showError('Please snap or upload your mall receipt photo.');
      fileInput.click();
      return;
    }

    setLoading(true);
    hideError();

    try {
      const formData = new FormData();
      formData.append('receiptImage', downsampledBlob, 'receipt.jpg');
      formData.append('shopId', selectedShopId);
      formData.append('form_rendered_at', new Date().toISOString());

      const turnstileResponse = document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement;
      if (turnstileResponse && turnstileResponse.value) {
        formData.append('cf-turnstile-response', turnstileResponse.value);
      }

      let voucherCode: string = '';
      let redemptionId: string = '';
      let claimToken: string = '';

      try {
        const response = await fetch('/api/v1/redemptions', {
          method: 'POST',
          body: formData,
        });

        const resJson = await response.json();
        if (!response.ok) {
          const ERROR_MESSAGES: Record<string, string> = {
            LOCATION_NOT_VERIFIED: 'Receipt location could not be verified. Please upload a receipt from 321 Clementi.',
            MINIMUM_SPEND_NOT_MET: 'Receipt spend does not meet the minimum $30 qualifying amount.',
            RECEIPT_EXPIRED: 'Receipt date is not today. Only same-day receipts are eligible.',
            INVALID_RECEIPT: 'The uploaded image does not appear to be a valid receipt.',
            DUPLICATE_RECEIPT: 'This receipt has already been used for redemption today.',
            LOW_CONFIDENCE_IMAGE: 'Receipt image is unclear. Please retake with better lighting.',
          };
          const message = ERROR_MESSAGES[resJson.error as string] || resJson.message || resJson.error || 'Redemption failed. Please try again.';
          showError(message);
          return;
        }

        voucherCode = resJson.data?.voucher_code || resJson.voucher_code;
        redemptionId = resJson.data?.redemption_id || '';
        claimToken = resJson.data?.claim_token || '';

        // Store claim_token in localStorage for 1-click fast unclaim
        if (claimToken && redemptionId) {
          localStorage.setItem(`clementi_claim_token_${redemptionId}`, claimToken);
        }

        currentReceiptNumber = resJson.data?.receipt_number || resJson.receipt_number || '';
      } catch {
        // Fallback for static preview/mock environments (strict 10-digit numeric per PAN-95)
        voucherCode = String(Math.floor(1000000000 + Math.random() * 9000000000));
        redemptionId = `mock-${Date.now()}`;
        claimToken = `tk_mock_${Date.now()}`;
        localStorage.setItem(`clementi_claim_token_${redemptionId}`, claimToken);
        currentReceiptNumber = `MOCK-RCPT-${Date.now()}`;
      }

      currentVoucherCode = voucherCode;
      currentRedemptionId = redemptionId;

      renderBarcodeScreen(voucherCode);
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Verification failed. Please try again.';
      showError(msg);
    } finally {
      setLoading(false);
    }
  });

  // Render Barcode Screen
  function renderBarcodeScreen(code: string) {
    formSection.classList.add('hidden');
    closedSection?.classList.add('hidden');
    barcodeSection.classList.remove('hidden');

    barcodeCodeText.textContent = code;

    try {
      JsBarcode(barcodeSvg, code, {
        format: 'CODE128',
        width: 2.2,
        height: 80,
        displayValue: false,
        margin: 10,
        background: '#FFFFFF',
        lineColor: '#000000',
      });
    } catch (err) {
      console.error('Barcode rendering error:', err);
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  resetBtn?.addEventListener('click', () => {
    closeEnlargeModal();
    barcodeSection.classList.add('hidden');
    formSection.classList.remove('hidden');
    hideError();
  });

  const closedOverrideBtn = document.getElementById('closed-mode-override-btn');
  closedOverrideBtn?.addEventListener('click', () => {
    closedSection?.classList.add('hidden');
    formSection.classList.remove('hidden');
  });

  // Download Barcode as PNG (Canvas-to-PNG for native mobile gallery support)
  function downloadBarcodePng() {
    if (!currentVoucherCode || !downloadCanvas) return;

    try {
      JsBarcode(downloadCanvas, currentVoucherCode, {
        format: 'CODE128',
        width: 2.5,
        height: 100,
        displayValue: false,
        margin: 12,
        background: '#FFFFFF',
        lineColor: '#000000',
      });

      const dataUrl = downloadCanvas.toDataURL('image/png');
      const link = document.createElement('a');
      link.href = dataUrl;
      link.download = `321Clementi-Barcode-${currentVoucherCode}.png`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    } catch (err) {
      console.error('Barcode PNG download error:', err);
    }
  }

  downloadBarcodeBtn?.addEventListener('click', downloadBarcodePng);

  // ============================================================================
  // 4. CLICK-TO-ENLARGE BARCODE MODAL (PAN-75 Scope 4 / PAN-82 Wake Lock)
  // Opens large high-contrast modal view; tap to dismiss; Escape to close.
  // Holds Screen Wake Lock (ADR-001 §6.6.2) to prevent display sleep at gantry.
  // ============================================================================
  async function acquireWakeLock() {
    if (typeof navigator === 'undefined' || !('wakeLock' in navigator)) {
      return;
    }
    if (wakeLockSentinel && !wakeLockSentinel.released) {
      return;
    }
    try {
      wakeLockSentinel = await navigator.wakeLock.request('screen');
      if (wakeLockBadge) wakeLockBadge.classList.remove('hidden');

      wakeLockSentinel.addEventListener('release', () => {
        wakeLockSentinel = null;
        if (wakeLockBadge) wakeLockBadge.classList.add('hidden');
      });
    } catch {
      // Screen Wake Lock is optional; catch silently if denied or unsupported
      wakeLockSentinel = null;
      if (wakeLockBadge) wakeLockBadge.classList.add('hidden');
    }
  }

  async function releaseWakeLock() {
    if (wakeLockSentinel) {
      try {
        await wakeLockSentinel.release();
      } catch {
        // Ignore errors during release
      } finally {
        wakeLockSentinel = null;
        if (wakeLockBadge) wakeLockBadge.classList.add('hidden');
      }
    }
  }

  function openEnlargeModal(code: string) {
    if (!enlargeModal) return;
    enlargeBarcodeText.textContent = code;

    try {
      JsBarcode(enlargeBarcodeSvg, code, {
        format: 'CODE128',
        width: 3.2,
        height: 140,
        displayValue: false,
        margin: 12,
        background: '#FFFFFF',
        lineColor: '#000000',
      });
    } catch (err) {
      console.error('Enlarged barcode render error:', err);
    }

    enlargeModal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    // Screen Wake Lock on open (ADR-001 §6.6.2)
    acquireWakeLock();
  }

  function closeEnlargeModal() {
    if (!enlargeModal) return;
    enlargeModal.classList.add('hidden');
    document.body.style.overflow = '';

    // Release Screen Wake Lock on every close path (backdrop tap, close button, Escape)
    releaseWakeLock();
  }

  barcodeBoxTrigger?.addEventListener('click', () => {
    if (currentVoucherCode) {
      openEnlargeModal(currentVoucherCode);
    }
  });

  closeEnlargeModalBtn?.addEventListener('click', closeEnlargeModal);
  dismissEnlargeBtn?.addEventListener('click', closeEnlargeModal);

  enlargeModal?.addEventListener('click', (e) => {
    if (e.target === enlargeModal) closeEnlargeModal();
  });

  // Re-acquire Screen Wake Lock on visibilitychange if modal remains open
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && enlargeModal && !enlargeModal.classList.contains('hidden')) {
      acquireWakeLock();
    }
  });

  // ============================================================================
  // 5. CLAIM HISTORY & RECOVERY VIEW (PAN-75 Scope 3)
  // ============================================================================
  function openHistoryDrawer() {
    if (!historyModal) return;
    historyModal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeHistoryDrawer() {
    if (!historyModal) return;
    historyModal.classList.add('hidden');
    document.body.style.overflow = '';
    fallbackUnclaimSection.classList.add('hidden');
    pendingUnclaimRecord = null;
  }

  openHistoryShortcutBtn?.addEventListener('click', () => openHistoryDrawer());
  closeHistoryDrawerBtn?.addEventListener('click', closeHistoryDrawer);
  historyModal?.addEventListener('click', (e) => {
    if (e.target === historyModal) closeHistoryDrawer();
  });

  historySearchBtn?.addEventListener('click', () => {
    const queryReceipt = historyReceiptInput.value.trim();
    if (!queryReceipt) {
      showHistoryAlert('Please enter a receipt number to search.', 'warning');
      return;
    }
    searchClaimHistory(queryReceipt);
  });

  async function searchClaimHistory(receipt: string) {
    clearHistoryAlert();
    historyLoadingSpinner.classList.remove('hidden');
    historyEmptyState.classList.add('hidden');
    historyResultsList.innerHTML = '';
    fallbackUnclaimSection.classList.add('hidden');

    try {
      const headers: Record<string, string> = {};

      const response = await fetch(`/api/v1/redemptions/history?receipt=${encodeURIComponent(receipt)}`, {
        headers,
      });

      if (!response.ok) {
        const errJson = await response.json().catch(() => ({}));
        showHistoryAlert(errJson.message || 'Unable to retrieve history. Please verify your receipt number.', 'error');
        historyLoadingSpinner.classList.add('hidden');
        return;
      }

      const json = await response.json();
      historyLoadingSpinner.classList.add('hidden');

      const records: ClaimHistoryRecord[] = json.data || [];
      if (records.length === 0) {
        historyEmptyState.classList.remove('hidden');
        return;
      }

      renderHistoryCards(records, receipt);
    } catch {
      // Offline/preview fallback
      historyLoadingSpinner.classList.add('hidden');
      if (currentVoucherCode) {
        renderHistoryCards([
          {
            id: currentRedemptionId || 'mock-current',
            voucher_code: currentVoucherCode,
            barcode_format: 'CODE128',
            receipt_amount: 30.00,
            receipt_date: new Date().toISOString().slice(0, 10),
            shop_name: 'Saizeriya',
            status: 'CLAIMED',
            can_unclaim: true,
            can_resume: true,
            expires_at: new Date(Date.now() + 15 * 60 * 1000).toISOString(),
            created_at: new Date().toISOString(),
          },
        ], receipt);
      } else {
        historyEmptyState.classList.remove('hidden');
      }
    }
  }

  function renderHistoryCards(records: ClaimHistoryRecord[], receipt: string) {
    historyResultsList.innerHTML = '';

    records.forEach((record) => {
      const card = document.createElement('div');
      card.className = 'border border-clementi-border rounded-xl p-4 bg-white shadow-xs space-y-3';

      const statusBadges: Record<string, { bg: string; text: string; label: string }> = {
        CLAIMED: { bg: 'bg-green-100 text-green-800 border-green-200', text: 'Active', label: 'CLAIMED' },
        UNCLAIMED: { bg: 'bg-slate-100 text-slate-700 border-slate-200', text: 'Unclaimed', label: 'UNCLAIMED' },
        EXPIRED: { bg: 'bg-amber-100 text-amber-800 border-amber-200', text: 'Expired', label: 'EXPIRED' },
        RE_REDEEMED: { bg: 'bg-blue-100 text-blue-800 border-blue-200', text: 'Re-redeemed', label: 'RE_REDEEMED' },
      };

      const badge = statusBadges[record.status] || { bg: 'bg-gray-100 text-gray-800', text: record.status, label: record.status };

      let actionsHtml = '';
      if (record.status === 'CLAIMED') {
        const isMasked = !record.voucher_code || record.voucher_code === '••••••••••';
        const canResume = record.can_resume === true;
        actionsHtml = `
          <div class="flex gap-2 pt-1">
            ${
              !isMasked && canResume
                ? `<button
                    type="button"
                    class="history-view-barcode-btn flex-1 py-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-white font-display font-bold text-xs flex items-center justify-center gap-1"
                    data-code="${record.voucher_code}"
                  >
                    <span class="material-symbols-outlined text-sm">fullscreen</span>
                    <span>View Barcode</span>
                  </button>`
                : `<div class="flex-1 py-2 rounded-lg bg-slate-100 border border-slate-200 text-slate-400 font-display font-bold text-xs flex items-center justify-center gap-1 cursor-not-allowed">
                    <span class="material-symbols-outlined text-sm">lock</span>
                    <span>Barcode Hidden</span>
                  </div>`
            }
            ${
              record.can_unclaim
                ? `<button
                    type="button"
                    class="history-unclaim-btn py-2 px-3 rounded-lg bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 font-display font-bold text-xs flex items-center justify-center gap-1"
                    data-id="${record.id}"
                    data-code="${record.voucher_code}"
                  >
                    <span class="material-symbols-outlined text-sm">undo</span>
                    <span>Unclaim</span>
                  </button>`
                : ''
            }
          </div>
        `;
      } else if (record.status === 'UNCLAIMED') {
        actionsHtml = `
          <div class="text-[11px] text-green-700 bg-green-50 rounded-lg p-2 font-medium flex items-center gap-1.5 border border-green-200">
            <span class="material-symbols-outlined text-sm text-green-600">check_circle</span>
            <span>Voucher released. Quota unlocked for today's redemption.</span>
          </div>
        `;
      }

      card.innerHTML = `
        <div class="flex items-start justify-between">
          <div>
            <div class="font-mono font-bold text-sm text-clementi-charcoal tracking-wider">
              ${record.voucher_code}
            </div>
            <div class="text-xs text-clementi-slate mt-0.5">
              ${record.shop_name != null ? record.shop_name : '••••••'} • ${record.receipt_amount != null ? `$${record.receipt_amount.toFixed(2)}` : '••••'}
            </div>
          </div>
          <span class="text-[10px] font-display font-bold px-2 py-0.5 rounded-full border ${badge.bg}">
            ${badge.label}
          </span>
        </div>
        <div class="text-[10px] text-slate-400">
          Redeemed: ${new Date(record.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} (${record.receipt_date})
        </div>
        ${actionsHtml}
      `;

      historyResultsList.appendChild(card);
    });

    // Attach Action Handlers
    historyResultsList.querySelectorAll('.history-view-barcode-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-code') || '';
        closeHistoryDrawer();
        openEnlargeModal(code);
      });
    });

    historyResultsList.querySelectorAll('.history-unclaim-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id') || '';
        const found = records.find((r) => r.id === id);
        if (found) initiateUnclaim(found, receipt);
      });
    });
  }

  // ============================================================================
  // 6. UNCLAIM ACTION WORKFLOW (Fast-Path & Fallback Verification)
  // ============================================================================
  async function initiateUnclaim(record: ClaimHistoryRecord, receipt: string) {
    const savedToken = localStorage.getItem(`clementi_claim_token_${record.id}`);

    if (savedToken) {
      // 1-Click Fast Path via localStorage Token
      if (confirm(`Unclaim voucher ${record.voucher_code} and release your daily parking quota?`)) {
        await executeUnclaim(record.id, receipt, { token: savedToken });
      }
    } else {
      // Secondary Verification Fallback (Lost session / new browser)
      pendingUnclaimRecord = record;
      fallbackUnclaimSection.classList.remove('hidden');
      fallbackUnclaimSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  cancelFallbackBtn?.addEventListener('click', () => {
    fallbackUnclaimSection.classList.add('hidden');
    pendingUnclaimRecord = null;
  });

  confirmFallbackBtn?.addEventListener('click', async () => {
    if (!pendingUnclaimRecord) return;
    const spendVal = parseFloat(fallbackSpendInput.value);
    const shopVal = fallbackShopSelect.value;

    if (isNaN(spendVal) || spendVal <= 0) {
      showHistoryAlert('Please enter your exact receipt spend amount.', 'warning');
      return;
    }
    if (!shopVal) {
      showHistoryAlert('Please select the shop you visited.', 'warning');
      return;
    }

    await executeUnclaim(pendingUnclaimRecord.id, historyReceiptInput.value.trim(), {
      receiptAmount: spendVal,
      shopId: shopVal,
    });
  });

  async function executeUnclaim(
    redemptionId: string,
    receipt: string,
    auth: { token?: string; receiptAmount?: number; shopId?: string }
  ) {
    try {
      const headers: Record<string, string> = {
        'Content-Type': 'application/json',
      };
      if (auth.token) headers['X-Claim-Token'] = auth.token;

      const body: Record<string, unknown> = {
        id: redemptionId,
        receipt_number: currentReceiptNumber || receipt,
      };
      if (auth.receiptAmount) body.receipt_amount = auth.receiptAmount;
      if (auth.shopId) body.shop_id = auth.shopId;

      const response = await fetch('/api/v1/redemptions/unclaim', {
        method: 'POST',
        headers,
        body: JSON.stringify(body),
      });

      const resJson = await response.json();
      if (!response.ok) {
        showHistoryAlert(resJson.message || resJson.error || 'Failed to unclaim voucher.', 'error');
        return;
      }

      showHistoryAlert('Voucher successfully unclaimed. Daily quota released.', 'success');
      fallbackUnclaimSection.classList.add('hidden');
      pendingUnclaimRecord = null;

      // Clean up localStorage
      localStorage.removeItem(`clementi_claim_token_${redemptionId}`);

      // Refresh history list
      searchClaimHistory(receipt);

      // If active ticket pass matches, reset to form
      if (currentRedemptionId === redemptionId) {
        barcodeSection.classList.add('hidden');
        formSection.classList.remove('hidden');
      }
    } catch {
      // Mock fallback
      showHistoryAlert('Voucher successfully unclaimed. Daily quota released.', 'success');
      fallbackUnclaimSection.classList.add('hidden');
      pendingUnclaimRecord = null;
      searchClaimHistory(receipt);
      if (currentRedemptionId === redemptionId) {
        barcodeSection.classList.add('hidden');
        formSection.classList.remove('hidden');
      }
    }
  }

  // Active pass unclaim trigger
  passUnclaimBtn?.addEventListener('click', () => {
    if (currentVoucherCode) {
      openHistoryDrawer();
    }
  });

  // ============================================================================
  // 7. KEYBOARD & GLOBAL EVENTS
  // ============================================================================
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (!enlargeModal.classList.contains('hidden')) closeEnlargeModal();
      else if (!historyModal.classList.contains('hidden')) closeHistoryDrawer();
    }
  });

  // Global listener from BottomNav or Header
  window.addEventListener('clementi:open-history', (() => {
    openHistoryDrawer();
  }) as EventListener);

  function setLoading(loading: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = loading;
    if (loading) {
      submitSpinner?.classList.remove('hidden');
      submitIcon?.classList.add('hidden');
      submitArrow?.classList.add('hidden');
      if (submitText) submitText.textContent = 'Generating Barcode...';
    } else {
      submitSpinner?.classList.add('hidden');
      submitIcon?.classList.remove('hidden');
      submitArrow?.classList.remove('hidden');
      if (submitText) submitText.textContent = 'Generate Carpark Barcode';
    }
  }

  function showError(msg: string) {
    if (!errorBanner || !errorMessage) return;
    errorMessage.textContent = msg;
    errorBanner.classList.remove('hidden');
    errorBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideError() {
    errorBanner?.classList.add('hidden');
  }

  function showHistoryAlert(msg: string, type: 'error' | 'warning' | 'success') {
    if (!historyAlertBanner || !historyAlertText) return;
    historyAlertText.textContent = msg;
    historyAlertBanner.className = 'rounded-xl p-3 text-xs flex items-start gap-2 ' +
      (type === 'error' ? 'bg-red-50 text-red-800 border border-red-200' :
       type === 'warning' ? 'bg-amber-50 text-amber-900 border border-amber-200' :
       'bg-green-50 text-green-800 border border-green-200');
    historyAlertBanner.classList.remove('hidden');
  }

  function clearHistoryAlert() {
    historyAlertBanner?.classList.add('hidden');
  }
</script>
