---
// Quick redemption operating banner
// Reflects official 321 Clementi promotion terms & conditions and Stitch export layout.
---

<section
  id="redemption-banner-section"
  class="w-full p-[2px] rounded-2xl bg-gradient-to-r from-clementi-crimson via-clementi-orange to-clementi-pink shadow-sm mb-5"
  aria-label="Operating Hours and Redemption Eligibility"
>
  <div class="bg-clementi-white rounded-[14px] p-4 sm:p-5 space-y-3">
    <!-- Top row live status -->
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2.5 w-2.5">
          <span id="banner-pulse-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-clementi-crimson opacity-75"></span>
          <span id="banner-pulse-dot" class="relative inline-flex rounded-full h-2.5 w-2.5 bg-clementi-crimson"></span>
        </span>
        <span id="banner-status-title" class="font-display text-xs tracking-wider text-clementi-crimson uppercase font-bold">
          Free 2 hours Parking Redemption
        </span>
      </div>

      <div
        id="live-operating-pill"
        class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 border border-emerald-200 text-emerald-700 font-display transition-colors"
      >
        <span id="live-operating-indicator" class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span id="operating-status-text">12:00 PM – 3:00 PM Active</span>
      </div>
    </div>

    <!-- Main Banner Callout (Heading 12:00 PM – 3:00 PM Weekdays only removed per spec) -->
    <div class="border-l-2 border-clementi-crimson pl-3 py-0.5">
      <p id="banner-sub-text" class="text-xs sm:text-sm text-clementi-slate font-body leading-relaxed">
        Lunch plans? Enjoy <strong class="text-clementi-charcoal font-semibold">2 Hours FREE Parking</strong> at 321 Clementi with min. $30 qualifying spend.
      </p>
    </div>

    <!-- 3 Condition Badges Grid from Stitch Refinement -->
    <div class="grid grid-cols-3 gap-2 pt-1">
      <div class="bg-clementi-subtle border border-clementi-border rounded-lg p-2 flex flex-col items-center text-center">
        <span class="material-symbols-outlined text-clementi-green text-base fill-1" style="font-variation-settings: 'FILL' 1;">check_circle</span>
        <span class="font-display text-[11px] font-bold text-clementi-charcoal mt-1">Mon–Fri Only</span>
        <span class="text-[10px] text-clementi-slate">Excl. Public Hol.</span>
      </div>

      <div class="bg-clementi-subtle border border-border rounded-lg p-2 flex flex-col items-center text-center">
        <span class="material-symbols-outlined text-clementi-green text-base fill-1" style="font-variation-settings: 'FILL' 1;">check_circle</span>
        <span class="font-display text-[11px] font-bold text-clementi-charcoal mt-1">Min $30 Spend</span>
        <span class="text-[10px] text-clementi-slate">Max 2 Receipts</span>
      </div>

      <div class="bg-clementi-subtle border border-border rounded-lg p-2 flex flex-col items-center text-center">
        <span class="material-symbols-outlined text-clementi-green text-base fill-1" style="font-variation-settings: 'FILL' 1;">check_circle</span>
        <span class="font-display text-[11px] font-bold text-clementi-charcoal mt-1">1 Pass / Day</span>
        <span class="text-[10px] text-clementi-slate">Per Patron / IU</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Client-side helper to reflect Singapore Time (SGT UTC+8) operating status
  function updateOperatingWindow() {
    const statusPill = document.getElementById('live-operating-pill');
    const statusText = document.getElementById('operating-status-text');
    const indicator = document.getElementById('live-operating-indicator');
    if (!statusPill || !statusText || !indicator) return;

    // Support mock preview force flag via query param or window global (e.g. ?state=closed or ?state=active)
    const urlParams = new URLSearchParams(window.location.search);
    const forcedState = urlParams.get('state');

    const now = new Date();
    // Convert to SGT (UTC+8)
    const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
    const sgtTime = new Date(utc + (3600000 * 8));

    const day = sgtTime.getDay(); // 0 = Sun, 1 = Mon, ..., 6 = Sat
    const hours = sgtTime.getHours();
    const isWeekday = day >= 1 && day <= 5;
    const isLunchHour = hours >= 12 && hours < 15;

    const isActive = forcedState === 'active' || (forcedState !== 'closed' && isWeekday && isLunchHour);
    const isUpcoming = forcedState !== 'closed' && !isActive && isWeekday && hours < 12;

    if (isActive) {
      statusPill.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 border border-emerald-200 text-emerald-700 font-display';
      indicator.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500';
      statusText.textContent = '12:00 PM – 3:00 PM Active';
      window.dispatchEvent(new CustomEvent('clementi:operating-status', { detail: { open: true } }));
    } else if (isUpcoming) {
      statusPill.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 border border-amber-200 text-amber-800 font-display';
      indicator.className = 'w-1.5 h-1.5 rounded-full bg-amber-500';
      statusText.textContent = 'Starts at 12:00 PM';
      window.dispatchEvent(new CustomEvent('clementi:operating-status', { detail: { open: false, upcoming: true } }));
    } else {
      statusPill.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 border border-slate-200 text-slate-700 font-display';
      indicator.className = 'w-1.5 h-1.5 rounded-full bg-slate-400';
      statusText.textContent = 'Closed • Weekdays 12–3 PM';
      window.dispatchEvent(new CustomEvent('clementi:operating-status', { detail: { open: false, upcoming: false } }));
    }
  }

  updateOperatingWindow();
  // Periodically refresh window status every minute
  setInterval(updateOperatingWindow, 60000);
</script>
